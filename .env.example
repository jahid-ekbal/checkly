# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema files in "/src/lib/env"
# directory should be updated accordingly.

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Disable Prisma telemetry
CHECKPOINT_DISABLE=1

# Example connection string for SQLite:
DATABASE_URL=file:./prisma/dev.db

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Full URL of the deployed app, e.g. http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Optional: comma-separated extra origins allowed for auth requests
BETTER_AUTH_ALLOWED_ORIGINS=

# Seed owner (prisma/seed.ts)
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=
